# APEX Live Trading Configuration
# Copy this file to `.env` ONLY when you are ready for real SOL trading.
# `.env` is already listed in `.gitignore` so your key will NEVER be committed to Git.

# Keep false while paper testing! Set to true ONLY when ready for live mainnet swaps.
APEX_LIVE_MODE=false

# Base58 private key of a DEDICATED trading burner wallet (never use your main wallet!)
WALLET_PRIVATE_KEY=

# Live trade size per entry (SOL). Recommended start: 0.10 (sweet spot: 0.10 - 0.30; hard cap 0.50)
LIVE_TRADE_SOL=0.10

# Minimum SOL always kept in wallet so open trades always have gas to exit
MIN_WALLET_RESERVE_SOL=0.05

# Daily realized loss circuit breaker (pauses new live buys for 24h if hit; still exits open trades)
DAILY_MAX_LOSS_SOL=0.40

# Slippage (%) and priority fees (SOL)
BUY_SLIPPAGE_PCT=8.0
SELL_SLIPPAGE_PCT=12.0
EMERGENCY_SLIPPAGE_PCT=25.0
PRIORITY_FEE_SOL=0.0004
EMERGENCY_PRIORITY_SOL=0.0008

# Swap router: "auto" (PumpPortal Local TX for Pump.fun + Jupiter v1 fallback), "pumpportal", or "jupiter"
SWAP_ROUTER=auto

# Optional: custom Helius / RPC endpoint and Jupiter Developer Portal API key
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# JUPITER_API_KEY=
